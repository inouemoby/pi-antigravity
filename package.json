{
  "name": "pi-antigravity",
  "version": "0.1.0",
  "description": "Use Google Antigravity OAuth models in Pi without installing the Antigravity CLI.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "antigravity", "gemini", "oauth"],
  "repository": {
    "type": "git",
    "url": "https://github.com/inouemoby/pi-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/inouemoby/pi-antigravity/issues"
  },
  "homepage": "https://github.com/inouemoby/pi-antigravity",
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@cortexkit/antigravity-auth-core": "^2.2.0",
    "esbuild": "^0.27.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.0"
  }
}
